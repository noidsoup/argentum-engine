        "rulings": [
            {
                "date": "2012-06-01",
                "text": "Etherium-Horn Sorcerer's first ability can only be activated when it is on the battlefield. If Etherium-Horn Sorcerer isn't on the battlefield when the ability resolves, the ability won't do anything."
            },
            {
                "date": "2021-06-18",
                "text": "A spell's mana value is determined only by its mana cost. Ignore any alternative costs, additional costs, cost increases, or cost reductions."
            },
            {
                "date": "2021-06-18",
                "text": "Cascade triggers when you cast the spell, meaning that it resolves before that spell. If you end up casting the exiled card, it will go on the stack above the spell with cascade."
            },
            {
                "date": "2021-06-18",
                "text": "When the cascade ability resolves, you must exile cards. The only optional part of the ability is whether or not you cast the last card exiled."
            },
            {
                "date": "2021-06-18",
                "text": "If a spell with cascade is countered, the cascade ability will still resolve normally."
