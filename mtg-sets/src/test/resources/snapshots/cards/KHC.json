                    "type": "CreateToken",
                    "count": {
                        "type": "ContextProperty",
                        "key": "TRIGGER_DAMAGE_AMOUNT"
                    },
                    "power": 1,
                    "toughness": 1,
                    "colors": [
                        "GREEN"
                    ],
                    "creatureTypes": [
                        "Elf",
