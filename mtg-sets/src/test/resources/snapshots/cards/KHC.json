                    "to": "Graveyard"
                },
                "binding": "ANY",
                "effect": {
                    "type": "Composite",
                    "effects": [
                        {
                            "type": "LoseLife",
                            "amount": {
                                "type": "Fixed",
                                "amount": 1
                            },
                            "target": {
                                "type": "PlayerRef",
                                "player": "EachOpponent"
                            }
                        },
                        {
                            "type": "GainLife",
                            "amount": {
                                "type": "Fixed",
                                "amount": 1
                            }
                        }
                    ]
                }
            }
